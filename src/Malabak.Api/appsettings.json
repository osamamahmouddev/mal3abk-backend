{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Database": {
    "ConnectionString": "",
    "MaxPoolSize": 100,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "ConnectionString": "",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "AbortOnConnectFail": false
  },
  "Identity": {
    "OtpDelivery": {
      "Provider": "None",
      "Slack": {
        "WebhookUrl": ""
      }
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "Malabak.Api",
      "Audience": "Malabak.Client",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "CurrentKeyId": "malabak-es256-key-v1"
    },
    "Turnstile": {
      "SecretKey": "",
      "SiteKey": "",
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
      "BypassInDevelopment": true
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5000",
        "http://localhost:5001"
      ]
    },
    "RateLimiter": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    }
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "WorkerCount": 10,
    "Queues": [
      "critical",
      "default",
      "low"
    ],
    "DashboardPath": "/admin/hangfire",
    "EnableDashboard": true,
    "BypassDashboardAuthInDevelopment": true,
    "DefaultRetryAttempts": 5,
    "PollIntervalSeconds": 5
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxRetries": 5,
    "PollIntervalSeconds": 5,
    "DistributedLockTimeoutSeconds": 30,
    "Enabled": true
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "ExpirationHours": 24,
    "LockTimeoutSeconds": 10,
    "LockDurationSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://malabak.app",
      "https://venue.malabak.app",
      "https://admin.malabak.app",
      "http://localhost:3000",
      "http://localhost:3001"
    ],
    "PreflightMaxAgeHours": 1
  },
  "Cloudflare": {
    "Enabled": true,
    "TrustLoopbackInDevelopment": true,
    "AdditionalTrustedProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  }
}
