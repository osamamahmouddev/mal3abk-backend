{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=malabak_dev;Username=malabak;Password=malabak_dev_password",
    "Redis": "localhost:6379,password=malabak_dev_redis_password,abortConnect=false"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=malabak_dev;Username=malabak;Password=malabak_dev_password",
    "MaxPoolSize": 100,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=malabak_dev_redis_password,abortConnect=false",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "AbortOnConnectFail": false
  },
  "Security": {
    "Jwt": {
      "Issuer": "Malabak.Api",
      "Audience": "Malabak.Client",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "CurrentKeyId": "malabak-es256-key-v1"
    },
    "Turnstile": {
      "SecretKey": "1x0000000000000000000000000000000AA",
      "SiteKey": "1x00000000000000000000AA",
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
      "BypassInDevelopment": true
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5000",
        "http://localhost:5001"
      ]
    },
    "RateLimiter": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  }
}
