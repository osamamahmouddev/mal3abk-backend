{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Request Rate (RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "P95 Request Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "P99 Request Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "5xx Error Percentage",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count[5m]))) * 100",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "HTTP Status Code Breakdown",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Route Latency Heatmap (Top Endpoints)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, http_route)) * 1000",
          "legendFormat": "{{http_route}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["malabak", "api", "performance"],
  "title": "Malabak - API Performance & Availability",
  "uid": "malabak-api-perf"
}
